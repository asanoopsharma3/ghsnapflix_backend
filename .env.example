PORT=3002

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=snapflix

DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_LOGGING=false

# HTTP request logs (one JSON object per line): storage/logs/{YYYY-MM}/{YYYY-MM-DD}.txt
LOG_DIR=storage/logs
LOG_ENABLED=true
LOG_ARCHIVE_ENABLED=true
LOG_MAX_RESPONSE_CHARS=50000
# Comma-separated path prefixes to skip (e.g. /api/v1/health)
LOG_SKIP_PATH_PREFIXES=
# Comma-separated header names to log (lowercase); empty = content-type, user-agent only
LOG_HEADER_NAMES=

# Excel batch subscription queue cron (needs mtn_subscription_queue table)
MTN_QUEUE_ENABLED=false

# Callback auto-subscription cron (non-Success callback_transactions → queue)
MTN_CALLBACK_AUTO_ENABLED=true
MTN_CALLBACK_AUTO_INTERVAL_MS=300000
MTN_CALLBACK_AUTO_FETCH_LIMIT=10

# Ghana MTN Consent Gateway (CGW) — HE / Non-HE
FRONTEND_BASE_URL=http://localhost:3000
JWT_SECRET=change_me
CGW_ENV=production
CGW_CALLBACK_URL=https://www.ghsnapflix.buzz/api/callback
CGW_HE_REDIRECT_URL=https://www.ghsnapflix.buzz/api/callback
CGW_OFFER_CODE=9923310010
CGW_INITIAL_OFFER_CODE=9923310010
CGW_HE_MOBILE_NUMBER=99999999999
CGW_HE_BASE_URL=http://102.133.198.92/Redirect
CGW_NON_HE_BASE_URL=https://cg.mtn.com.gh/Portal
# Local frontend bypass (POST /api/v1/subscription/dev-activate)
ENABLE_LOCAL_SUBSCRIPTION=false

# Optional: protect POST /api/v1/cgw/activate
# SDP_CALLBACK_SECRET=
# SDP_CALLBACK_ALLOWED_IPS=
